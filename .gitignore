# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/dist/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# C++ Engine
/engine/build/
/engine/*.exe
/engine/*.dll
/engine/*.exp
/engine/*.lib
/engine/*.pdb
/engine/selfplay*.txt
/engine/*_match_result.txt
/engine/test_selfplay.txt
/engine/*.log

# Large datasets, training dumps, and benchmarks
/data/
*.bak
*.bin
/bench.txt
/test_gen1.txt
/test_graph.txt

# Secrets and environment configs
**/.env
*.env
!*.env.example

# Python virtual environment and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
